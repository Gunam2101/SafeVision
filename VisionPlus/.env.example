# Used by docker-compose.yml. Copy to .env before running `docker compose up`.
# For Vercel + Render deployment instead of Docker, see DEPLOYMENT.md —
# those platforms use their own dashboards for environment variables, not
# this file, so nothing here is read by Vercel/Render directly.

POSTGRES_PASSWORD=change-this-password
SECRET_KEY=change-this-to-a-long-random-string-in-production

# Optional: enables real Grok (xAI) chatbot responses instead of the
# built-in rule-based one. Leave blank to skip.
GROK_API_KEY=
